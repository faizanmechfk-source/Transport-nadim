{
  "name": "transport-entry-desktop",
  "version": "1.0.0",
  "description": "Transport Entry Windows Desktop Application",
  "main": "electron-main.cjs",
  "author": "Transport Entry",
  "repository": {
    "type": "git",
    "url": "https://github.com/faizanmechfk-source/Transport-nadim.git"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.transportentry.app",
    "productName": "Transport Entry",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.cjs",
      "preload.cjs",
      "icon.ico",
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Transport Entry"
    }
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  }
}
